DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/vaultx?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_API_KEY="replace-with-a-separate-long-random-secret"
PAYOUT_OPERATOR_EMAILS=""
WITHDRAWAL_MONITOR_ENABLED="false"
WITHDRAWAL_SCAN_INTERVAL_MS="15000"
# Tatum/KMS mainnet payout automation remains off until KMS is provisioned,
# the payout address is confirmed, and limits have been reviewed.
PAYOUT_AUTOMATION_ENABLED="false"
TATUM_API_KEY=""
TATUM_KMS_SIGNATURE_ID=""
TATUM_PAYOUT_WALLET_ADDRESS=""
PAYOUT_MAX_SINGLE_USDT="0"
PAYOUT_DAILY_LIMIT_USDT="0"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
RESEND_API_KEY="re_replace_with_your_resend_api_key"
EMAIL_FROM="VaultX <no-reply@example.com>"

# BEP20 chain monitoring settings. Never use a recovery phrase or private key here.
# BSC xpubs reveal wallet activity; keep them private.
# BNB's free Alchemy endpoint supports eth_getLogs; scanner queries at most 10 blocks per call.
# Legacy TRON deposit monitoring settings; used only to verify old requests, not new deposits or payouts.
DEPOSIT_SCAN_INTERVAL_MS="30000"
BSC_RPC_URL="https://bnb-mainnet.g.alchemy.com/public"
BSC_USDT_CONTRACT="0x55d398326f99059fF775485246999027B3197955"
BSC_RECEIVE_ADDRESS=""
# Public BNB Smart Chain payout wallet address used by Tatum KMS and outgoing-transfer verifier.
BSC_SEND_ADDRESS=""
BSC_DEPOSIT_XPUB=""
BSC_MIN_CONFIRMATIONS="12"

TRON_RPC_URL="https://api.trongrid.io"
TRON_GRID_API_KEY=""
TRON_USDT_CONTRACT="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"
TRON_RECEIVE_ADDRESS=""
TRON_SEND_ADDRESS=""
